<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	 MacIsland runs WITHOUT the App Sandbox on purpose:
	   - the File Shelf keeps arbitrary user files across launches (bookmarks without security scope),
	   - Apple Events to Music/Spotify need only the TCC "Automation" consent, not a sandbox exception.
	 If you later want a sandboxed build (App Store), enable it here and add:
	   com.apple.security.automation.apple-events = YES
	   com.apple.security.personal-information.calendars = YES
	   com.apple.security.files.user-selected.read-write = YES
	 and switch ShelfStore to security-scoped bookmarks.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened runtime: this resource-access entitlement is REQUIRED to send Apple Events (Music/Spotify control). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
